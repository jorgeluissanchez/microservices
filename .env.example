# Main Environment Variables for Docker Compose
# Database Configuration
MONGODB_URI=mongodb://root:password123@mongo:27017/microservices?authSource=admin
POSTGRES_PAYMENT_HOST=postgres-payment
POSTGRES_PAYMENT_PORT=5432
POSTGRES_PAYMENT_DATABASE=payment_db
POSTGRES_PAYMENT_USERNAME=payment_user
POSTGRES_PAYMENT_PASSWORD=payment_password

POSTGRES_RESERVATION_HOST=postgres-reservation
POSTGRES_RESERVATION_PORT=5432
POSTGRES_RESERVATION_DATABASE=reservation_db
POSTGRES_RESERVATION_USERNAME=reservation_user
POSTGRES_RESERVATION_PASSWORD=reservation_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=3600

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Service URLs (for Docker)
AUTH_SERVICE_URL=http://auth:3001
PAYMENT_SERVICE_URL=http://payment:3002
RESERVATION_SERVICE_URL=http://reservation:3003

# Kafka Configuration
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_JMX_PORT=9101
KAFKA_JMX_HOSTNAME=localhost
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Zookeeper Configuration
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Kafka UI Configuration
KAFKA_CLUSTERS_0_NAME=local
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:29092
KAFKA_CLUSTERS_0_ZOOKEEPER=zookeeper:2181
